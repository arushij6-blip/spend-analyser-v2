  "description": "Personal spend analyser: ingests transactions from Gmail (Axis Bank alerts) and uploaded credit-card statement PDFs (HDFC Diners), categorizes them, and visualizes spending",
  "type": "module",
  "scripts": {
    "auth": "node src/auth.js",
    "validate": "node src/validate-one.js",
    "fetch-all": "node src/fetch-all.js",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "next": "^15.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14"
