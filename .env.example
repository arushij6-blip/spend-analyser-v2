# ===========================================================================
# Vercel env vars for spend-analyser-v2.
#
# Copy this file to .env.local for local dev (gitignored), or paste the same
# keys into Vercel → Project → Settings → Environment Variables.
#
# The DATABASE_URL / POSTGRES_URL pair is auto-populated by the Neon
# integration on Vercel — you don't have to set them manually there.
# ===========================================================================

# -------- Postgres (auto-set by Vercel + Neon integration) --------
DATABASE_URL=postgres://...               # pooled, what the app uses at runtime
DATABASE_URL_UNPOOLED=postgres://...      # direct, used by the one-off backfill script
# (Vercel also injects POSTGRES_URL aliases for legacy compatibility — fine to ignore.)

# -------- Gmail OAuth (you set these) --------
# Run `node src/auth.js you@gmail.com` locally first to mint a refresh token,
# then read it out of ~/.gmail-mcp/tokens.json and paste here.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ACCOUNT_EMAILS=you@gmail.com,partner@gmail.com
# One env var per account. Slug = email upper-cased, non-alnum → underscore.
#   you@gmail.com      → GMAIL_REFRESH_TOKEN_YOU_GMAIL_COM
#   partner@gmail.com  → GMAIL_REFRESH_TOKEN_PARTNER_GMAIL_COM
GMAIL_REFRESH_TOKEN_YOU_GMAIL_COM=
GMAIL_REFRESH_TOKEN_PARTNER_GMAIL_COM=

# -------- Telegram alerts (optional; omit to disable) --------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------- Cron security (required if you keep vercel.json crons) --------
# Any opaque string. Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}`
# automatically when this is set. Generate with:  openssl rand -hex 32
CRON_SECRET=

# -------- User config (mirrors config.local.js for hosts without that file) --------
DEFAULT_SOURCE=Axis
EMAIL_SOURCE_MAP_JSON={"you@gmail.com":"Axis","partner@gmail.com":"Joint Axis"}
SELF_OWNED_ACCOUNTS_JSON=["123456789012345"]
STAFF_SALARY_PATTERNS_JSON=["FIRST LAST"]
